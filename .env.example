# OpenAI-compatible provider. For the SpatialAI relay, keep this base URL.
AI_PROVIDER=anthropic
OPENAI_BASE_URL=https://spatialai.vip
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=claude-3-5-haiku-20241022
AI_REQUEST_TIMEOUT_MS=90000

# The relay's official variable names are also supported.
ANTHROPIC_BASE_URL=https://spatialai.vip
ANTHROPIC_AUTH_TOKEN=sk-your-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional. Keep empty until client-side Vercel Blob upload is wired in.
BLOB_READ_WRITE_TOKEN=
