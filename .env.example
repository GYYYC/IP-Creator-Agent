# OpenAI-compatible provider. For the SpatialAI relay, keep this base URL.
AI_PROVIDER=anthropic
OPENAI_BASE_URL=https://spatialai.vip
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=claude-3-5-haiku-20241022
AI_REQUEST_TIMEOUT_MS=90000

# Optional. Used by Doctor to transcribe uploaded videos before diagnosis.
# If your chat relay does not support /v1/audio/transcriptions, point this to OpenAI.
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIPTION_API_KEY=sk-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIPTION_TIMEOUT_MS=90000
AI_TRANSCRIPTION_MAX_BYTES=25165824

# The relay's official variable names are also supported.
ANTHROPIC_BASE_URL=https://spatialai.vip
ANTHROPIC_AUTH_TOKEN=sk-your-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional. Used for Doctor video uploads before transcription.
BLOB_READ_WRITE_TOKEN=
BLOB_MAX_UPLOAD_BYTES=524288000
