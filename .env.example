# IP Creator Agent - Vercel Environment Variables
# SpatialAI = main analysis, Doubao AUC = transcription, Vercel Blob = video uploads.
# Replace every placeholder value before deploying.

AI_PROVIDER=openai
OPENAI_BASE_URL=https://spatialai.vip
OPENAI_API_KEY=your-spatialai-api-key
OPENAI_MODEL=gpt-5.5
AI_REQUEST_TIMEOUT_MS=90000
AI_VISION_REQUEST_TIMEOUT_MS=180000
AI_IMAGE_DETAIL=auto
DOCTOR_VISUAL_INPUT_LIMIT=6
DOCTOR_FRAME_TIME_LIMIT=6

BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
BLOB_MAX_UPLOAD_BYTES=2147483648
BLOB_SOURCE_SIGNING_SECRET=replace-with-a-long-random-secret

TRANSCRIPTION_PROVIDER=doubao
AI_TRANSCRIPTION_TIMEOUT_MS=240000
AI_TRANSCRIPTION_MAX_BYTES=4194304
DOUBAO_ASR_DIRECT_UPLOAD_MAX_BYTES=4194304
DOUBAO_ASR_API_KEY=your-doubao-auc-api-key
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc
DOUBAO_ASR_SUBMIT_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
DOUBAO_ASR_QUERY_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
DOUBAO_ASR_TIMEOUT_MS=240000
DOUBAO_ASR_POLL_INTERVAL_MS=2000

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

TOS_ACCESS_KEY_ID=your-volcengine-tos-access-key-id
TOS_SECRET_ACCESS_KEY=your-volcengine-tos-secret-access-key
TOS_BUCKET=your-tos-bucket
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_PUBLIC_URL_TTL_SECONDS=1800
TOS_SOURCE_VERIFY_TIMEOUT_MS=15000
